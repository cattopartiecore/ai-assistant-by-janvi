# Streamlit Community Cloud / Local Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml (locally) or paste into:
# Streamlit Cloud App -> Settings -> Secrets

# LLM Provider: "gemini" (recommended) or "groq"
LLM_PROVIDER = "gemini"

# Google Gemini API Key (get free at https://aistudio.google.com/)
GOOGLE_API_KEY = "your_google_api_key_here"

# Model Selection
GEMINI_MODEL = "gemini-3.5-flash-lite"

# Optional Alternative Provider: Groq (get free key at https://console.groq.com/)
GROQ_API_KEY = "your_groq_api_key_here"
GROQ_MODEL = "llama-3.1-8b-instant"

# Retrieval Configuration
SIMILARITY_THRESHOLD = "0.40"
TOP_K = "3"
