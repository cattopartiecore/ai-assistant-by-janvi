# LLM Provider Configuration ("gemini" or "groq")
LLM_PROVIDER=gemini

# Google Gemini API Key (free tier available at https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (alternative provider, free tier available at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.1-8b-instant

# Chroma Vector Store Persistence Directory
CHROMA_PERSIST_DIR=./chroma_db

# Similarity Score Threshold (Cosine similarity 0.0 to 1.0)
SIMILARITY_THRESHOLD=0.40
TOP_K=3
